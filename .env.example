# ==============================================================================
# roroworld.org 환경 변수 템플릿
# 복사하여 .env.local 을 생성한 뒤 실제 값을 채워넣으세요.
# .env.local 은 .gitignore에 등록되어 있으므로 Git에 커밋되지 않습니다.
# ==============================================================================

# 1. 데이터베이스 연결 (필수)
# 로컬 Docker Compose DB 기본값:
# DATABASE_URL=postgres://roroworld:roroworld@localhost:5432/roroworld
# 운영 DB 연결 시 (Supabase 또는 PostgreSQL URI):
DATABASE_URL=postgres://roroworld:roroworld@localhost:5432/roroworld

# 2. JWT 인증 세션 시크릿 (필수)
# 세션 토큰 서명 및 검증용 32자 이상의 보안 문자열
JWT_SECRET=dev-jwt-secret-key-must-be-at-least-32-characters-long

# 3. OAuth2 소셜 로그인 (네이버 / 카카오)
# 네이버 로그인 (Naver Developers 애플리케이션)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 로그인 (Kakao Developers REST API 키 / Client Secret)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 4. Cloudflare R2 스토리지 (갤러리 사진 업로드용)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=roroworld
R2_PUBLIC_URL=https://your-r2-public-url.com

# 5. 애플리케이션 및 도메인 설정 (선택 사항)
# NEXT_PUBLIC_APP_URL=https://roroworld.org
# COOKIE_DOMAIN=.roroworld.org
# NEXT_PUBLIC_CONTACT_EMAIL=contact@roroworld.org
# 기존 Spring 백엔드 개발자 콘솔 설정(api.roroworld.org) 유지 시:
# OAUTH_REDIRECT_BASE_URL=https://api.roroworld.org
